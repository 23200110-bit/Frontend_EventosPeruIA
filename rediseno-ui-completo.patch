+  color: var(--buy-text) !important;
+  font-weight: 800;
+  letter-spacing: 0.01em;
+  box-shadow: 0 10px 22px -12px var(--buy);
+}
+
+.btn-buy.q-btn:hover {
+  background: var(--buy-hover) !important;
+}
+
+.btn-buy.q-btn.disabled,
+.btn-buy.q-btn[disabled] {
+  background: var(--border-color) !important;
+  color: var(--text-secondary) !important;
+  box-shadow: none;
+}
