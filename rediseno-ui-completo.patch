diff --git a/src/utils/formatters.js b/src/utils/formatters.js
index 0b87c87..afd314d 100644
--- a/src/utils/formatters.js
+++ b/src/utils/formatters.js
@@ -13,4 +13,56 @@ export function date(value) {
         timeZone: 'America/Lima'
       }).format(new Date(value))
     : 'Por confirmar'
-}
\ No newline at end of file
+}
+
+const LIMA = 'America/Lima'
+
+function parts(value, options) {
+  const out = {}
+  for (const p of new Intl.DateTimeFormat('es-PE', { timeZone: LIMA, ...options }).formatToParts(new Date(value))) {
+    out[p.type] = p.value
+  }
+  return out
+}
+
+function clean(text) {
+  return String(text || '').replace('.', '').toLowerCase()
+}
+
+// Formato corto para tarjetas: "sáb 14 dic · 21:00"
+export function shortDate(value) {
+  if (!value) return 'Por confirmar'
+  const d = new Date(value)
+  if (Number.isNaN(d.getTime())) return 'Por confirmar'
+  const p = parts(value, {
+    weekday: 'short',
+    day: 'numeric',
+    month: 'short',
+    hour: '2-digit',
+    minute: '2-digit',
+    hourCycle: 'h23'
+  })
+  return clean(p.weekday) + ' ' + p.day + ' ' + clean(p.month) + ' · ' + p.hour + ':' + p.minute
+}
+
+// Clave de día en hora de Lima: "2026-12-14"
+export function limaDayKey(value) {
+  const p = parts(value, { year: 'numeric', month: '2-digit', day: '2-digit' })
+  return p.year + '-' + p.month + '-' + p.day
+}
+
+// Encabezado de grupo por día: "Hoy", "Mañana" o "Sábado, 14 de diciembre"
+export function dayHeading(value) {
+  if (!value) return 'Fecha por confirmar'
+  const key = limaDayKey(value)
+  const now = new Date()
+  if (key === limaDayKey(now)) return 'Hoy'
+  if (key === limaDayKey(new Date(now.getTime() + 86400000))) return 'Mañana'
+  const text = new Intl.DateTimeFormat('es-PE', {
+    timeZone: LIMA,
+    weekday: 'long',
+    day: 'numeric',
+    month: 'long'
+  }).format(new Date(value))
+  return text.charAt(0).toUpperCase() + text.slice(1)
+}
diff --git a/src/utils/themeManager.js b/src/utils/themeManager.js
new file mode 100644
index 0000000..51e5a04
--- /dev/null
+++ b/src/utils/themeManager.js
@@ -0,0 +1,59 @@
+import { ref } from 'vue'
+import { Dark } from 'quasar'
+
+export const THEME_OPTIONS = {
+  SYSTEM: 'system',
+  LIGHT: 'light',
+  DARK: 'dark'
+}
+
+const STORAGE_KEY = 'app-theme-preference'
+const VALID = [THEME_OPTIONS.SYSTEM, THEME_OPTIONS.LIGHT, THEME_OPTIONS.DARK]
+
+export function getStoredTheme() {
+  try {
+    const value = localStorage.getItem(STORAGE_KEY)
+    return VALID.includes(value) ? value : THEME_OPTIONS.SYSTEM
+  } catch {
+    return THEME_OPTIONS.SYSTEM
+  }
+}
+
+// Elección actual, reactiva para el selector del encabezado
+export const themeChoice = ref(getStoredTheme())
+
+// Valor para la opción "dark" de Quasar: 'auto' sigue al sistema
+export function quasarDarkSetting(theme = themeChoice.value) {
+  if (theme === THEME_OPTIONS.DARK) return true
+  if (theme === THEME_OPTIONS.LIGHT) return false
+  return 'auto'
+}
+
+function applyAttribute(theme) {
+  const root = document.documentElement
+  if (theme === THEME_OPTIONS.SYSTEM) root.removeAttribute('data-theme')
+  else root.setAttribute('data-theme', theme)
+}
+
+// Aplica la elección a las variables CSS y a los componentes de Quasar
+export function applyTheme(theme) {
+  applyAttribute(theme)
+  Dark.set(quasarDarkSetting(theme))
+}
+
+export function setTheme(theme) {
+  if (!VALID.includes(theme)) return
+  themeChoice.value = theme
+  try {
+    localStorage.setItem(STORAGE_KEY, theme)
+  } catch {
+    // Sin almacenamiento disponible: la elección vale sólo en esta pestaña
+  }
+  applyTheme(theme)
+}
+
+// Antes de montar: sólo el atributo, para que las variables CSS no parpadeen.
+// Quasar toma su modo de la opción config.dark en main.js.
+export function initializeTheme() {
+  applyAttribute(themeChoice.value)
+}
