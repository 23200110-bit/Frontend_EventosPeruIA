+  :root:not([data-theme="light"]) .desktop-nav a,
+  :root:not([data-theme="light"]) .mobile-links a { color: #d9d0ff; }
+  :root:not([data-theme="light"]) .desktop-nav a.nav-pill-active,
+  :root:not([data-theme="light"]) .mobile-links a.nav-pill-active {
+    background: rgba(124, 92, 245, 0.28);
+    color: #ffffff;
+    box-shadow: none;
+  }
+  :root:not([data-theme="light"]) .mobile-links { background: #15131f; }
+}
+
+:root[data-theme="dark"] .topbar {
+  background: #15131f;
+  color: var(--text-primary);
+  border-color: var(--border-color);
+}
+:root[data-theme="dark"] .brand-peru { color: #e8b264; }
+:root[data-theme="dark"] .brand small { border-color: var(--border-color); }
