+/* UI System: Shared component styles and modern design patterns.
+   Import this AFTER style.css and experience.css in main.js.
+   Color palette uses CSS variables: --bg-primary, --text-primary, --brand, etc.
+   Supports both light and dark modes automatically.
+*/
+
+/* ---- Refined Input Fields ---- */
+.q-field--outlined .q-field__control {
+  border-radius: 10px;
+  background: var(--bg-primary) !important;
+  color: var(--text-primary) !important;
+  border-color: var(--border-color) !important;
+}
+
+.q-field--outlined.q-field--focused .q-field__control {
+  border-color: var(--brand) !important;
+  box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand) 20%, transparent) !important;
+}
+
+/* ---- Buttons: Modern rounded style ---- */
+.q-btn {
+  border-radius: 10px;
+  font-weight: 600;
+  letter-spacing: 0;
+  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.q-btn--primary:not(.q-btn--flat):not(.q-btn--disable):not(.q-btn--loading) {
+  background: var(--brand) !important;
+  color: white !important;
+  box-shadow: 0 4px 12px color-mix(in srgb, var(--brand) 30%, transparent);
+}
+
+.q-btn--primary:not(.q-btn--flat):not(.q-btn--disable):hover {
+  transform: translateY(-1px);
+  box-shadow: 0 6px 20px color-mix(in srgb, var(--brand) 40%, transparent);
+}
+
+.q-btn--primary:not(.q-btn--flat):not(.q-btn--disable):active {
+  transform: translateY(0);
+}
+
+.q-btn.rounded-full {
+  border-radius: 999px;
+}
+
+/* ---- Typography Utility ---- */
+.text-eyebrow {
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 1px;
+  text-transform: uppercase;
+  color: var(--brand);
+}
+
+.text-muted {
+  color: var(--text-secondary);
+}
+
+/* ---- Surfaces and Cards ---- */
+.surface-elevated {
+  background: var(--bg-primary);
+  border: 1px solid var(--border-color);
+  border-radius: 16px;
+  box-shadow: 0 1px 3px color-mix(in srgb, var(--text-primary) 5%, transparent);
+}
+
+.surface-elevated:hover {
+  box-shadow: 0 4px 12px color-mix(in srgb, var(--text-primary) 8%, transparent);
+  border-color: var(--brand);
+}
+
+/* ---- Status Badges: Soft, modern pill style ---- */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 6px 12px;
+  border-radius: 999px;
+  font-size: 12px;
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.badge-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.badge-success {
+  background: color-mix(in srgb, var(--success) 15%, transparent);
+  color: var(--success);
+}
+
+.badge-warning {
+  background: color-mix(in srgb, var(--warning) 15%, transparent);
+  color: var(--warning);
+}
+
+.badge-danger {
+  background: color-mix(in srgb, var(--danger) 15%, transparent);
+  color: var(--danger);
+}
+
+.badge-info {
+  background: color-mix(in srgb, var(--brand) 15%, transparent);
+  color: var(--brand);
+}
+
+/* ---- Responsive Grid ---- */
+.grid-auto-fit {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 20px;
+}
+
+@media (max-width: 640px) {
+  .grid-auto-fit {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* ---- Empty State ---- */
+.empty-state {
+  text-align: center;
+  padding: 48px 24px;
+  background: var(--bg-secondary);
+  border-radius: 14px;
+  border: 1px solid var(--border-color);
+}
+
+.empty-state__icon {
+  font-size: 48px;
+  color: var(--text-secondary);
+  margin-bottom: 12px;
+}
+
+.empty-state__title {
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--text-primary);
+  margin-bottom: 6px;
+}
+
+.empty-state__description {
+  font-size: 14px;
+  color: var(--text-secondary);
+  margin-bottom: 20px;
+}
+
+/* ---- Loading Spinner ---- */
+.spinner-wrapper {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 12px;
+  padding: 40px 20px;
+  color: var(--text-secondary);
+}
+
+/* ---- Divider ---- */
+.divider {
+  height: 1px;
+  background: var(--border-color);
+  margin: 20px 0;
+}
+
+.divider-label {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  color: var(--text-secondary);
+  font-size: 13px;
+  margin: 20px 0;
+}
+
+.divider-label::before,
+.divider-label::after {
+  content: '';
+  flex: 1;
+  height: 1px;
+  background: var(--border-color);
+}
+
+/* ---- Utility: Respect motion preferences ---- */
+@media (prefers-reduced-motion: reduce) {
